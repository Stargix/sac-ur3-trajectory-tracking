# Generated files
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Training outputs — checkpoints and logs are regenerated on every run
checkpoints/
logs/
debugs/

# Large binary weights — only curated files in weights/ are tracked
# (best_model.zip and ur3_sac_final.zip are committed intentionally)
weights/ur3_sac_*.zip
!weights/best_model.zip
!weights/ur3_sac_final.zip

# Results — regenerated by evaluate.py, except the committed sample_run
results/*.mp4
results/*.png
!results/workspace_check.png
!results/sample_run/

# Environment / IDE
.env
.venv
venv/
.vscode/
.idea/

# MuJoCo runtime logs
MUJOCO_LOG.TXT

# macOS
.DS_Store
